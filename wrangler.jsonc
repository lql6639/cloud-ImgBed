{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-imgbed",
  "main": "deploy/worker/index.js",
  "compatibility_date": "2024-08-21",
  "compatibility_flags": ["global_fetch_strictly_public"],

  "assets": {
    "directory": "./frontend-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "images": { "binding": "IMAGES" },

  "observability": { "enabled": true },

  // 保留原有的 workers.dev 测试域名（不加这一行，部署后会被默认关闭）
  "workers_dev": true,

  "routes": [
    { "pattern": "img.lovlin.cn", "custom_domain": true }
  ],

  // 文件索引：D1（库名 img，绑定名必须是 img_d1 —— 代码里写死 env.img_d1）
  // 注意：KV 与 D1 同时绑定时适配器优先用 KV，所以这里刻意不再绑定 img_url
  "d1_databases": [
    {
      "binding": "img_d1",
      "database_name": "img",
      "database_id": "07a38601-07ca-41d4-894c-425a7b5c8a2f"
    }
  ],

  // 存储通道：R2（桶名 img，绑定名必须是 img_r2 —— 代码里写死 env.img_r2）
  // 只要该绑定存在，管理端会自动出现并启用 R2_env 渠道
  "r2_buckets": [
    {
      "binding": "img_r2",
      "bucket_name": "img"
    }
  ]
}
